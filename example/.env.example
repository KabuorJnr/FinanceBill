# Copy to .env and fill in. .env is gitignored.
# Google Maps SDK for Android key, read by app.config.js.
GOOGLE_MAPS_API_KEY=

# Firebase web app config (Project settings > General > Your apps > Web app).
# Leave empty to keep events on the device only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in. Web client ID: Firebase > Authentication > Google provider >
# "Web SDK configuration". iOS client ID: GoogleService-Info.plist CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Microsoft sign-in: Azure app registration (Application (client) ID).
# Redirect URI to register (Mobile and desktop): tikiti://auth
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT=common
