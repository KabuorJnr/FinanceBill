rules_version = '2';

// Tikiti: anyone can browse events; only signed-in organisers can post, and
// only the organiser who posted an event can change or delete it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isValidEvent(event) {
      return event.keys().hasAll(['title', 'category', 'date', 'time', 'venue', 'tiers', 'organizer', 'organizerId'])
        && event.title is string && event.title.size() >= 3 && event.title.size() <= 80
        && event.category in ['concert', 'festival', 'comedy', 'sports', 'culture', 'conference']
        && event.date is string && event.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && event.time is string && event.time.matches('^[0-9]{2}:[0-9]{2}$')
        && event.tiers is list && event.tiers.size() >= 1 && event.tiers.size() <= 5
        && event.description is string && event.description.size() <= 400
        && event.organizerId == request.auth.uid
        && event.organizer.id == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && isValidEvent(request.resource.data);
      allow update: if signedIn()
        && resource.data.organizerId == request.auth.uid
        && isValidEvent(request.resource.data);
      allow delete: if signedIn() && resource.data.organizerId == request.auth.uid;
    }

    match /organizers/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;
      allow delete: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
