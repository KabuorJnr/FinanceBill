{
  "name": "morphlet-example",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.21",
    "@react-navigation/native": "^7.5.0",
    "@rit3zh/gradients": "^0.1.3",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.26",
    "expo-backdrop": "^0.1.1",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-content-transition": "^0.1.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-better-maps": "^1.2.1",
    "react-native-cupertino-tabs": "^1.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screen-transitions": "^4.0.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/MorphletExample.xcworkspace -UseNewBuildSystem=YES -scheme MorphletExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "symbols": "swift scripts/export-symbols.swift && prettier --write src/components/symbol-images.ts"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~57.0.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0"
  }
}
